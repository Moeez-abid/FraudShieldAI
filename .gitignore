# Environments
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Data: not committed. `make data` downloads and rebuilds everything; teammates can
# also copy data/ from the shared Google Drive folder to skip the slow PhiUSIIL
# download. Small provenance files stay tracked: data/raw/MANIFEST.json (source
# URLs + SHA-256), *.stats.json, split manifests (row IDs + hashes) and the
# hand-labelled challenge set.
data/raw/*
!data/raw/MANIFEST.json
data/interim/*
!data/interim/*.stats.json
data/processed/*.parquet
data/processed/*.npy
*.part

# Model artefacts (large)
models/*
!models/.gitkeep

# Streamlit secrets
.streamlit/secrets.toml

# Per-example error dumps (contain dataset text; regenerate with make eval-val)
reports/errors/

# Teammate bundle (models + raw data), shared via Google Drive, not git
fraudshield_share*.zip
